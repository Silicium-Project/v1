# HTTPS public devant le service API. Le domaine vient de SIL_DOMAIN (fichier
# /etc/caddy/silicium.env, voir docs/technical/deployment.md). Certificat Let's Encrypt automatique.
{$SIL_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
