# Variables du service API (services/api). Copier vers /etc/silicium/api.env (root:silicium, 0640).
# Lues une seule fois au démarrage. Aucun secret ici : le jeton du nœud est lu depuis son fichier.

# Écoute locale : Caddy relaie HTTPS vers cette adresse.
SIL_API_ADDR=127.0.0.1:8080
SIL_API_STORE=/var/lib/silicium/api/store.json
SIL_API_NODE_URL=http://127.0.0.1:8750
SIL_API_NODE_TOKEN_FILE=/var/lib/silicium/node/control.token
SIL_API_WEB_DIR=/opt/silicium/web
# Origines des clients bureau (webview Tauri). Vide = aucun client bureau autorisé.
SIL_API_CORS_ORIGINS=http://tauri.localhost,tauri://localhost
# Obtenue par : silicium-node --config /etc/silicium/node.toml --public-key (voir deployment.md).
SIL_API_SESSION_HOURS=24
SIL_API_LOG_JSON=true

# Origines supplémentaires que le site peut appeler : le RPC Solana pour le dépôt de l'escrow.
SIL_API_CONNECT_SRC=https://api.devnet.solana.com

# Paiements : true seulement quand un adaptateur de chaîne règle les jobs (ici, devnet).
SIL_API_PAYMENTS=false
