{
  "name": "silicium-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop --outDir dist-desktop --emptyOutDir"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.2",
    "happy-dom": "^15.11.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
