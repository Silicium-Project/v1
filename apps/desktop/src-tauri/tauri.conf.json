{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silicium",
  "version": "0.1.0",
  "identifier": "org.silicium.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../../web run build:desktop",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silicium",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:8080; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
