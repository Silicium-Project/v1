{
  "schema": "silicium.workload/v1",
  "id": "rendu/raytracer",
  "description": "Une unité = un pixel de la bande du fragment. L'entrée est une scène .cfg, rendue par le moteur raytracing déterministe (sil-raytracer) ; un vérificateur recalcule un échantillon de blocs de 8 lignes.",
  "unit": "pixels_band",
  "label_key": "submit.workloadRender",
  "input": {
    "params": ["width", "height"],
    "max_side": 4096,
    "max_input_bytes": 8388608
  },
  "geometry": {
    "block_rows": 8
  },
  "split": {
    "max_fragments": 16,
    "target_size": 32
  },
  "terms": {
    "reward_per_unit": 1,
    "verifier_reward_per_unit": 1
  },
  "verification": {
    "policy": "sampling",
    "min_cheat_fraction": 0.2,
    "target_detection": 0.99
  },
  "limits": {
    "wall_ms": 600000,
    "memory_bytes": 1073741824,
    "output_bytes": 268435456
  },
  "deposit": "supported",
  "resources": {
    "compute": 90,
    "memory": 40,
    "network": 10,
    "storage": 30
  }
}
